# ─── Graham Investment Intelligence — environment ───────────────────────────
# Copy to .env and fill in. All values are read on the server only; nothing
# here is ever sent to the browser (src/server/env.ts is "server-only").

# PostgreSQL connection string (docker compose up -d db gives you this one).
DATABASE_URL="postgresql://graham:graham_dev_pw@localhost:5432/graham_dev?schema=public"

# SEC EDGAR requires a descriptive User-Agent with contact details.
# https://www.sec.gov/os/accessing-edgar-data
# Needed for: security master sync + annual financial statements (US).
SEC_USER_AGENT="GrahamInvestmentIntelligence your-name your-email@example.com"

# Tiingo end-of-day prices, dividends and splits (free tier available).
# https://www.tiingo.com/account/api/token
# Without it, prices are shown as missing (never estimated).
TIINGO_API_KEY=""

# Development fixtures: fictional companies on the fictional "DEVX" exchange,
# labelled everywhere in the UI. Leave "false" for real research.
ENABLE_DEV_FIXTURES="false"
