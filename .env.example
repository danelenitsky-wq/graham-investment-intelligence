# ─── Graham Investment Intelligence — environment ───────────────────────────
# Copy to .env and fill in. All values are read on the server only; nothing
# here is ever sent to the browser (src/server/env.ts is "server-only").

# PostgreSQL connection string (docker compose up -d db gives you this one).
DATABASE_URL="postgresql://graham:graham_dev_pw@localhost:5432/graham_dev?schema=public"

# SEC EDGAR requires a descriptive User-Agent with contact details.
# https://www.sec.gov/os/accessing-edgar-data
# Needed for: security master sync + annual financial statements (US).
SEC_USER_AGENT="GrahamInvestmentIntelligence your-name your-email@example.com"

# ─── Free-first data providers ────────────────────────────────────────────
# No paid subscription is required. Minimum useful setup: SEC_USER_AGENT +
# TIINGO_API_KEY (both free). Everything else below is optional.

# Tiingo (free): 20+ years of official daily prices, dividends and splits, and
# the official last close used as the quote of record.
# https://www.tiingo.com/account/api/token
# Without it, prices are shown as missing (never estimated).
TIINGO_API_KEY=""
# Tiingo plan: free | power | commercial. On the free plan (50 requests/hour,
# 1,000/day) quotes are the official last close and refresh on demand only;
# the IEX endpoint is only used on power/commercial.
TIINGO_PLAN="free"

# Finnhub (optional, free plan): intraday US quote, 60 calls/min. Shown as
# "Delayed" (Finnhub does not document real-time delivery for the free plan).
# https://finnhub.io/dashboard
FINNHUB_API_KEY=""

# Twelve Data (optional, free Basic plan): US quote with 52-week range,
# 8 credits/min and 800/day, so it is used on demand, never auto-polled.
# https://twelvedata.com/account/api-keys
TWELVE_DATA_API_KEY=""

# Financial Modeling Prep (optional, FREE Basic plan only): independent
# cross-check of annual SEC statements (about 5 years). Never required; no
# paid FMP plan is used. FMP_PLAN is no longer read.
# https://site.financialmodelingprep.com/developer/docs/dashboard
FMP_API_KEY=""

# ─── Access control ───────────────────────────────────────────────────────
# The app has no user accounts: whoever reaches it can read the portfolio,
# change settings and spend the free API quotas. With APP_PASSWORD set, every
# page and API route asks for HTTP Basic credentials (use HTTPS in front of
# it). In production (`npm start`) the app refuses to serve without
# APP_PASSWORD unless APP_AUTH_DISABLED="true" (only for a machine that
# listens on localhost). Use 16+ random characters.
APP_USERNAME="graham"
APP_PASSWORD=""
APP_AUTH_DISABLED="false"

# Shared secret for GET /api/cron/check-filings (daily new-filing check).
# Leave empty to disable the endpoint. Use 16+ random characters.
CRON_SECRET=""

# Development fixtures: fictional companies on the fictional "DEVX" exchange,
# labelled everywhere in the UI. Leave "false" for real research.
ENABLE_DEV_FIXTURES="false"
