// Graham Investment Intelligence — database schema
//
// Design notes
// - Single-user personal research platform: no User model yet. Portfolios,
//   watchlists and settings are owned by the installation.
// - Every market/financial fact carries provenance: the DataSource it came from
//   and the DataFetch (ingestion run) that wrote it. Rows from development
//   fixtures are marked through DataSource.isDevFixture and must never be
//   presented as real market data.
// - Monetary values use Decimal to avoid binary floating point drift in storage.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Reference data ─────────────────────────────

enum Market {
  US
  IL // Tel Aviv Stock Exchange (TASE) — architecture ready, no provider yet
  OTHER
}

enum AssetType {
  COMMON_STOCK
  PREFERRED_STOCK
  ADR
  ETF
  REIT
  OTHER
}

model Exchange {
  id         String     @id @default(cuid())
  code       String     @unique // e.g. NASDAQ, NYSE, TASE
  mic        String?    @unique // ISO 10383 market identifier, e.g. XNAS, XTAE
  name       String
  nameHe     String?
  market     Market
  country    String // ISO 3166-1 alpha-2
  currency   String // ISO 4217 trading currency (TASE quotes in ILA/agorot)
  timezone   String // IANA timezone
  securities Security[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Security {
  id                 String    @id @default(cuid())
  ticker             String
  exchangeId         String
  exchange           Exchange  @relation(fields: [exchangeId], references: [id])
  name               String
  nameHe             String?
  assetType          AssetType @default(COMMON_STOCK)
  // Identifiers: US issuers use SEC CIK; TASE uses the TASE security number.
  cik                String? // zero-padded 10 digit SEC Central Index Key
  isin               String?
  taseSecurityNumber String?
  figi               String?
  sector             String?
  industry           String?
  sicCode            String?
  isUtility          Boolean   @default(false) // Graham applies different tests to utilities
  reportingCurrency  String? // currency of financial statements
  fiscalYearEndMonth Int? // 1-12
  isActive           Boolean   @default(true)
  // Daily check for newly published periodic reports (SEC submissions).
  lastFilingCheckAt      DateTime?
  latestFilingAccession  String?
  latestFilingForm       String?
  latestFilingDate       DateTime? @db.Date
  latestFilingAcceptedAt DateTime?
  // Where the reference record itself came from.
  sourceId           String?
  source             DataSource? @relation(fields: [sourceId], references: [id])

  priceBars        PriceBar[]
  corporateActions CorporateAction[]
  statements       FinancialStatement[]
  snapshots        AnalysisSnapshot[]
  positions        Position[]
  transactions     PortfolioTransaction[]
  watchlistItems   WatchlistItem[]
  alerts           Alert[]
  fetches          DataFetch[]
  qualityIssues    DataQualityIssue[]
  quotes           QuoteSnapshot[]
  verifications    DataVerification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ticker, exchangeId])
  @@index([cik])
  @@index([isin])
  @@index([name])
}

// ─────────────────────────── Provenance & freshness ──────────────────────────

enum DataSourceKind {
  REFERENCE // security master / ticker lists
  FUNDAMENTALS
  PRICES
  MACRO // bond yields, CPI
  MANUAL // values typed in by the user
}

model DataSource {
  id           String         @id @default(cuid())
  key          String         @unique // stable identifier, e.g. "sec-edgar", "tiingo", "dev-fixture"
  name         String
  kind         DataSourceKind
  baseUrl      String?
  termsUrl     String?
  description  String?
  // True for explicitly labelled development fixtures. Never real data.
  isDevFixture Boolean        @default(false)

  fetches          DataFetch[]
  securities       Security[]
  priceBars        PriceBar[]
  corporateActions CorporateAction[]
  statements       FinancialStatement[]
  qualityIssues    DataQualityIssue[]
  quotes           QuoteSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum FetchStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

// One ingestion run against one provider endpoint.
model DataFetch {
  id           String      @id @default(cuid())
  sourceId     String
  source       DataSource  @relation(fields: [sourceId], references: [id])
  securityId   String?
  security     Security?   @relation(fields: [securityId], references: [id], onDelete: SetNull)
  dataset      String // e.g. "companyfacts", "daily-prices", "ticker-universe"
  endpoint     String // request URL with secrets removed
  status       FetchStatus @default(RUNNING)
  httpStatus   Int?
  recordCount  Int?
  errorMessage String?
  payloadHash  String? // sha256 of raw payload, for change detection/audit
  startedAt    DateTime    @default(now())
  completedAt  DateTime?

  priceBars        PriceBar[]
  corporateActions CorporateAction[]
  statements       FinancialStatement[]
  quotes           QuoteSnapshot[]

  @@index([sourceId, startedAt])
  @@index([securityId, dataset, startedAt])
}

enum IssueSeverity {
  INFO
  WARNING
  ERROR
}

model DataQualityIssue {
  id         String        @id @default(cuid())
  securityId String?
  security   Security?     @relation(fields: [securityId], references: [id], onDelete: Cascade)
  sourceId   String?
  source     DataSource?   @relation(fields: [sourceId], references: [id])
  severity   IssueSeverity
  code       String // machine readable, e.g. BALANCE_SHEET_MISMATCH
  message    String
  context    Json?
  detectedAt DateTime      @default(now())
  resolvedAt DateTime?

  @@index([securityId, resolvedAt])
}

// ──────────────────────────────── Market data ────────────────────────────────

model PriceBar {
  id         String     @id @default(cuid())
  securityId String
  security   Security   @relation(fields: [securityId], references: [id], onDelete: Cascade)
  date       DateTime   @db.Date // trading session date (exchange local)
  open       Decimal?   @db.Decimal(20, 6)
  high       Decimal?   @db.Decimal(20, 6)
  low        Decimal?   @db.Decimal(20, 6)
  close      Decimal    @db.Decimal(20, 6)
  adjClose   Decimal?   @db.Decimal(20, 6) // split/dividend adjusted
  volume     BigInt?
  currency   String
  sourceId   String
  source     DataSource @relation(fields: [sourceId], references: [id])
  fetchId    String?
  fetch      DataFetch? @relation(fields: [fetchId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())

  @@unique([securityId, date, sourceId])
  @@index([securityId, date])
}

enum CorporateActionType {
  CASH_DIVIDEND
  STOCK_SPLIT
}

model CorporateAction {
  id         String              @id @default(cuid())
  securityId String
  security   Security            @relation(fields: [securityId], references: [id], onDelete: Cascade)
  type       CorporateActionType
  exDate     DateTime            @db.Date
  payDate    DateTime?           @db.Date
  amount     Decimal?            @db.Decimal(20, 6) // per share, for dividends
  ratio      Decimal?            @db.Decimal(20, 8) // for splits (new/old)
  currency   String?
  sourceId   String
  source     DataSource          @relation(fields: [sourceId], references: [id])
  fetchId    String?
  fetch      DataFetch?          @relation(fields: [fetchId], references: [id], onDelete: SetNull)
  // SINGLE_SOURCE unless an independent source (e.g. SEC dividends declared per share) agrees.
  verificationStatus VerificationStatus @default(UNVERIFIED)
  createdAt  DateTime            @default(now())

  @@unique([securityId, type, exDate, sourceId])
}

// ───────────────────────────── Financial statements ──────────────────────────

enum StatementType {
  INCOME
  BALANCE_SHEET
  CASH_FLOW
}

enum PeriodType {
  ANNUAL
  QUARTERLY
  TTM
}

enum VerificationStatus {
  UNVERIFIED // not checked yet
  VERIFIED // an independent source agrees within tolerance
  CONFLICT // an independent source disagrees beyond tolerance
  SINGLE_SOURCE // no independent value available to compare
}

model FinancialStatement {
  id              String          @id @default(cuid())
  securityId      String
  security        Security        @relation(fields: [securityId], references: [id], onDelete: Cascade)
  statementType   StatementType
  periodType      PeriodType
  fiscalYear      Int
  fiscalPeriod    String // FY, Q1, Q2, Q3, Q4
  periodStart     DateTime?       @db.Date // null for balance sheet (instant)
  periodEnd       DateTime        @db.Date
  currency        String
  form            String? // 10-K, 10-Q, 20-F ...
  accessionNumber String? // SEC accession number of the filing the values came from
  filedAt         DateTime?       @db.Date
  isRestated      Boolean         @default(false) // values taken from a later filing than the original
  sourceId        String
  source          DataSource      @relation(fields: [sourceId], references: [id])
  fetchId         String?
  fetch           DataFetch?      @relation(fields: [fetchId], references: [id], onDelete: SetNull)
  lineItems       FinancialLineItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([securityId, statementType, periodType, periodEnd, sourceId])
  @@index([securityId, periodType, fiscalYear])
}

// A normalized line item. `concept` is our canonical key (see
// src/lib/normalization/concepts.ts); `sourceConcept` preserves the original
// taxonomy tag (e.g. us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax).
model FinancialLineItem {
  id            String             @id @default(cuid())
  statementId   String
  statement     FinancialStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  concept       String
  sourceConcept String
  value         Decimal            @db.Decimal(30, 6)
  unit          String // USD, shares, USD/shares
  accessionNumber String?
  filedAt       DateTime?          @db.Date
  splitAdjusted Boolean            @default(false)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  // Provenance per figure: the filing document (EDGAR index URL) and when we retrieved it.
  sourceUrl     String?
  retrievedAt   DateTime?

  @@unique([statementId, concept])
}

// ──────────────────────────────── Quotes ─────────────────────────────────────

enum QuoteFeed {
  REALTIME // provider documents real-time delivery for the configured plan
  DELAYED
  EOD
  UNKNOWN // not confirmed: never shown as Live
}

// Every successful quote retrieval is kept (append-only), so the last verified
// value survives provider outages and every displayed price is auditable.
model QuoteSnapshot {
  id                 String             @id @default(cuid())
  securityId         String
  security           Security           @relation(fields: [securityId], references: [id], onDelete: Cascade)
  sourceId           String
  source             DataSource         @relation(fields: [sourceId], references: [id])
  fetchId            String?
  fetch              DataFetch?         @relation(fields: [fetchId], references: [id], onDelete: SetNull)
  price              Decimal            @db.Decimal(20, 6)
  previousClose      Decimal?           @db.Decimal(20, 6)
  change             Decimal?           @db.Decimal(20, 6)
  changePercent      Float?
  open               Decimal?           @db.Decimal(20, 6)
  dayHigh            Decimal?           @db.Decimal(20, 6)
  dayLow             Decimal?           @db.Decimal(20, 6)
  volume             BigInt?
  marketCap          Decimal?           @db.Decimal(24, 2)
  yearHigh           Decimal?           @db.Decimal(20, 6)
  yearLow            Decimal?           @db.Decimal(20, 6)
  currency           String
  exchange           String?
  feed               QuoteFeed
  feedNote           String?
  delayMinutes       Int?
  sourceTimestamp    DateTime // provider's trade/quote time
  retrievedAt        DateTime           @default(now()) // when we received it
  sessionState       String // OPEN / CLOSED / UNKNOWN at retrieval (cache invalidation)
  sessionDate        String // exchange-local YYYY-MM-DD at retrieval
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verificationNote   String?
  payloadHash        String?
  // Manual price updates (e.g. TASE without a free price feed): the value as
  // typed, its unit (ILA = agorot), and the user's source label. `price` holds
  // the normalized major-unit value (ILS).
  isManual           Boolean            @default(false)
  enteredPrice       Decimal?           @db.Decimal(20, 6)
  enteredUnit        String?
  sourceLabel        String?

  @@index([securityId, retrievedAt])
}

// ─────────────────────────────── FX rates ────────────────────────────────────

enum FxRateKind {
  OFFICIAL // published by a central bank (Bank of Israel representative rate)
  MANUAL // typed in by the user, with a date and a source label
}

// One exchange rate observation: 1 `base` = `rate` `quote` on `rateDate`.
model FxRate {
  id          String     @id @default(cuid())
  base        String // ISO 4217, e.g. USD
  quote       String // ISO 4217, e.g. ILS
  rate        Decimal    @db.Decimal(20, 8)
  rateDate    DateTime   @db.Date
  kind        FxRateKind
  sourceKey   String // "boi" or "manual"
  sourceLabel String
  fetchId     String?
  retrievedAt DateTime   @default(now())

  @@unique([base, quote, rateDate, sourceKey])
  @@index([base, quote, rateDate])
}

// ───────────────────────────── Verification ──────────────────────────────────

// One comparison of a material figure between the primary source and an
// independent one. Open (unresolved) CONFLICT rows block downstream analysis.
model DataVerification {
  id                 String             @id @default(cuid())
  securityId         String
  security           Security           @relation(fields: [securityId], references: [id], onDelete: Cascade)
  dataset            String // "financials" | "quote"
  metric             String
  periodType         PeriodType?
  fiscalYear         Int?
  fiscalPeriod       String?
  periodEnd          DateTime?          @db.Date
  primarySource      String
  primaryValue       Decimal?           @db.Decimal(30, 6)
  primaryReference   String?
  secondarySource    String
  secondaryValue     Decimal?           @db.Decimal(30, 6)
  secondaryReference String?
  relDiff            Float?
  tolerance          Float?
  status             VerificationStatus
  checkedAt          DateTime           @default(now())
  resolvedAt         DateTime? // superseded by a later check

  @@index([securityId, dataset, resolvedAt])
  @@index([securityId, status])
}

// ─────────────────────────────── Analysis ────────────────────────────────────

enum Methodology {
  GRAHAM_1973 // strictly The Intelligent Investor, 4th ed.
  MODERN_EXTENSION // clearly separated modern additions
}

// Immutable record of an engine run, including the exact inputs used, so a
// result can always be explained and reproduced later.
model AnalysisSnapshot {
  id            String      @id @default(cuid())
  securityId    String
  security      Security    @relation(fields: [securityId], references: [id], onDelete: Cascade)
  engine        String // e.g. "graham-defensive", "graham-enterprising", "valuation"
  engineVersion String
  methodology   Methodology
  asOfDate      DateTime    @db.Date // date of the price used
  priceUsed     Decimal?    @db.Decimal(20, 6)
  inputs        Json
  results       Json
  dataQuality   Json?
  inputsHash    String
  usesDevFixtureData Boolean @default(false)
  computedAt    DateTime    @default(now())

  @@index([securityId, engine, computedAt])
}

// ─────────────────────────────── Portfolio ───────────────────────────────────

model Portfolio {
  id           String                 @id @default(cuid())
  name         String
  description  String?
  baseCurrency String                 @default("USD")
  positions    Position[]
  transactions PortfolioTransaction[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

model Position {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  securityId  String
  security    Security  @relation(fields: [securityId], references: [id])
  quantity    Decimal   @db.Decimal(24, 8)
  averageCost Decimal   @db.Decimal(20, 6) // per share, in `currency`
  currency    String
  openedAt    DateTime?
  notes       String?
  // Graham strategy recorded as the reason the position was bought (DEFENSIVE |
  // ENTERPRISING | NET_NET). The decision engine checks the thesis against it.
  thesisStrategy String?
  /** Security type as declared by the user (ETF positions are not screened with company criteria). */
  securityType AssetType?
  /** Unit the average price was entered in (ILA = agorot); `averageCost` is always in major units. */
  costInputUnit String?
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([portfolioId, securityId])
}

enum ImportKind {
  CSV
  PDF_STATEMENT // prepared for a future local (no paid service) statement extractor
  MANUAL
}

// One confirmed import. Rows are validated and previewed before anything is saved.
model ImportBatch {
  id          String     @id @default(cuid())
  kind        ImportKind
  fileName    String?
  contentHash String
  rowCount    Int
  summary     Json?
  createdAt   DateTime   @default(now())
  positions   Position[]
  transactions PortfolioTransaction[]
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
  SPLIT
  FEE
}

model PortfolioTransaction {
  id          String          @id @default(cuid())
  portfolioId String
  portfolio   Portfolio       @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  securityId  String?
  security    Security?       @relation(fields: [securityId], references: [id])
  type        TransactionType
  tradeDate   DateTime        @db.Date
  quantity    Decimal?        @db.Decimal(24, 8)
  price       Decimal?        @db.Decimal(20, 6)
  fees        Decimal?        @db.Decimal(20, 6)
  currency    String
  notes       String?
  importBatchId String?
  importBatch   ImportBatch?  @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())

  @@index([portfolioId, tradeDate])
}

// ─────────────────────────────── Watchlists ──────────────────────────────────

model Watchlist {
  id        String          @id @default(cuid())
  name      String
  isDefault Boolean         @default(false)
  items     WatchlistItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model WatchlistItem {
  id          String    @id @default(cuid())
  watchlistId String
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  securityId  String
  security    Security  @relation(fields: [securityId], references: [id], onDelete: Cascade)
  notes       String?
  /** User's target purchase price, in `targetCurrency` (major units). */
  targetPrice    Decimal? @db.Decimal(20, 6)
  targetCurrency String?
  /** Margin-of-safety target for this stock (fraction); null = the settings default. */
  marginOfSafetyTarget Float?
  addedAt     DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@unique([watchlistId, securityId])
}

// ──────────────────────────────── Alerts ─────────────────────────────────────

enum AlertType {
  PRICE_ABOVE
  PRICE_BELOW
  MARGIN_OF_SAFETY_ABOVE
  GRAHAM_CRITERIA_CHANGED
  DATA_STALE
  GRAHAM_PURCHASE_THRESHOLD
  CUSTOM_TARGET_PRICE
  MARGIN_OF_SAFETY_TARGET
  NEW_FILING
  CURRENT_RATIO_DETERIORATION
  DEBT_INCREASE
  EARNINGS_DETERIORATION
  DIVIDEND_INTERRUPTION
  NET_NET_CHANGE
}

enum AlertStatus {
  ACTIVE
  TRIGGERED
  DISABLED
}

model Alert {
  id              String      @id @default(cuid())
  securityId      String?
  security        Security?   @relation(fields: [securityId], references: [id], onDelete: Cascade)
  type            AlertType
  threshold       Decimal?    @db.Decimal(20, 6)
  params          Json?
  status          AlertStatus @default(ACTIVE)
  lastEvaluatedAt DateTime?
  lastTriggeredAt DateTime?
  note            String?
  /** Evaluator state between runs (last condition, last seen filing…) for edge-triggered alerts. */
  state           Json?
  events          AlertEvent[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([securityId, type])
  @@index([status])
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

// In-app alert history. `dedupeKey` is unique: the same occurrence is never recorded twice.
model AlertEvent {
  id             String        @id @default(cuid())
  alertId        String?
  alert          Alert?        @relation(fields: [alertId], references: [id], onDelete: SetNull)
  securityId     String?
  type           AlertType
  severity       AlertSeverity
  dedupeKey      String        @unique
  message        String // i18n code
  params         Json
  observedValue  Decimal?      @db.Decimal(30, 6)
  threshold      Decimal?      @db.Decimal(30, 6)
  runId          String?
  run            AlertRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  triggeredAt    DateTime      @default(now())
  acknowledgedAt DateTime?

  @@index([triggeredAt])
  @@index([securityId, triggeredAt])
}

enum AlertRunTrigger {
  MANUAL // "Run checks now" in the app
  SCHEDULED // /api/cron/check-alerts called by an external scheduler
  SCRIPT // npm run alerts:check
}

// One alert-check run. The app reports background monitoring as active only
// when a SCHEDULED run has actually completed recently.
model AlertRun {
  id            String          @id @default(cuid())
  trigger       AlertRunTrigger
  startedAt     DateTime        @default(now())
  completedAt   DateTime?
  checked       Int             @default(0)
  newEvents     Int             @default(0)
  duplicates    Int             @default(0)
  providerCalls Int             @default(0)
  skipped       Int             @default(0)
  errors        Json?
  events        AlertEvent[]

  @@index([trigger, startedAt])
}

// ─────────────────────────────── Settings ────────────────────────────────────

// Key/value application settings, validated in code by zod schemas
// (src/lib/settings/schema.ts). Secrets (API keys) never live here; they stay
// in server-side environment variables.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
